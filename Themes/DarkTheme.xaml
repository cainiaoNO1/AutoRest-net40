<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== 1. 调色板与画刷 (Palette & Brushes) ==================== -->
  <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#161922" Offset="0.0" />
    <GradientStop Color="#111318" Offset="1.0" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="CardBgBrush" Color="#1A1D26" />
  <SolidColorBrush x:Key="CardBgHoverBrush" Color="#222632" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2F3D" />

  <SolidColorBrush x:Key="InsetBgBrush" Color="#0D0F14" />
  <SolidColorBrush x:Key="InsetBorderBrush" Color="#222633" />

  <!-- 关机主题主渐变 (电光蓝) -->
  <LinearGradientBrush x:Key="PrimaryBlueGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2563EB" Offset="0.0" />
    <GradientStop Color="#0284C7" Offset="1.0" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="BlueAccentBrush" Color="#38BDF8" />
  <SolidColorBrush x:Key="BlueBorderBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="BlueCardBgBrush" Color="#1E293B" />

  <!-- 重启主题主渐变 (琥珀橙) -->
  <LinearGradientBrush x:Key="RestartAmberGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#D97706" Offset="0.0" />
    <GradientStop Color="#EA580C" Offset="1.0" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AmberAccentBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="AmberBorderBrush" Color="#EA580C" />
  <SolidColorBrush x:Key="AmberCardBgBrush" Color="#2C2216" />

  <!-- 危险 / 取消状态色 -->
  <SolidColorBrush x:Key="DangerRedBrush" Color="#EF4444" />
  <SolidColorBrush x:Key="DangerRedBgBrush" Color="#26EF4444" />
  <SolidColorBrush x:Key="DangerRedBorderBrush" Color="#66EF4444" />

  <!-- 文字颜色 -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#4B5563" />


<Window x:Class="AutoRest.Views.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoRest 关机预警"
        Width="380"
        Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

  <Border Margin="14"
          Background="{StaticResource WindowBgBrush}"
          BorderBrush="{StaticResource DangerRedBrush}"
          BorderThickness="1.5"
          CornerRadius="16"
          Effect="{StaticResource WindowShadow}">
    <Grid Margin="20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 顶部标题与警告角标 -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource DangerRedBgBrush}" Margin="0,0,10,0">
          <Path Data="{StaticResource IconPower}"
                Fill="{StaticResource DangerRedBrush}"
                Stretch="Uniform"
                Width="16"
                Height="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="TxtWarningTitle"
                   Text="系统即将在 60 秒后执行关机"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- 中间倒数秒数展示 -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10">
        <TextBlock x:Name="TxtCountdownSeconds"
                   Text="60"
                   FontSize="54"
                   FontWeight="Bold"
                   FontFamily="Consolas, Segoe UI"
                   Foreground="{StaticResource DangerRedBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="秒后将强制保存并关闭/重启所有应用"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0" />
      </StackPanel>

      <!-- 底部操作按钮 -->
      <Grid Grid.Row="2" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 推迟 10 分钟 -->
        <Button Grid.Column="0"
                Content="推迟 10 分钟"
                Style="{StaticResource QuickChipButtonStyle}"
                Height="40"
                FontSize="13"
                FontWeight="SemiBold"
                Click="OnPostponeClicked" />

        <!-- 立即取消任务 -->
        <Button Grid.Column="2"
                Content="■ 取消任务"
                Style="{StaticResource DangerOutlineButtonStyle}"
                Height="40"
                FontSize="13"
                Click="OnCancelClicked" />
      </Grid>
    </Grid>
  </Border>
</Window>

<UserControl x:Class="AutoRest.Controls.TimeWheelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="128" d:DesignWidth="360">

  <Border Background="{StaticResource InsetBgBrush}"
          BorderBrush="{StaticResource InsetBorderBrush}"
          BorderThickness="1"
          CornerRadius="10"
          Height="128"
          SnapsToDevicePixels="True"
          ClipToBounds="True">
    <Grid>
      <!-- 中间高亮横向选中带 -->
      <Border Height="40"
              VerticalAlignment="Center"
              Background="#1A2563EB"
              BorderBrush="#4D3B82F6"
              BorderThickness="1"
              CornerRadius="8"
              Margin="8,0"
              IsHitTestVisible="False" />

      <!-- 三列数字区 -->
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 第一列：小时 -->
        <Border Grid.Column="0" Background="Transparent" PreviewMouseWheel="OnHoursMouseWheel">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtHourPrev"
                       Text="00"
                       FontSize="13"
                       FontFamily="Consolas, Segoe UI"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       MouseDown="OnHourPrevClicked"
                       Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock x:Name="TxtHourCurr"
                         Text="01"
                         FontSize="24"
                         FontWeight="Bold"
                         FontFamily="Consolas, Segoe UI"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text=" 时"
                         FontSize="12"
                         FontWeight="Normal"
                         Foreground="{StaticResource BlueAccentBrush}"
                         VerticalAlignment="Bottom"
                         Margin="2,0,0,3" />
            </StackPanel>
            <TextBlock x:Name="TxtHourNext"
                       Text="02"
                       FontSize="13"
                       FontFamily="Consolas, Segoe UI"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       MouseDown="OnHourNextClicked"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- 分隔符 1 (冒号) -->
        <TextBlock Grid.Column="1"
                   Text=":"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextMutedBrush}"
                   VerticalAlignment="Center"
                   Margin="4,0,4,2" />

        <!-- 第二列：分钟 -->
        <Border Grid.Column="2" Background="Transparent" PreviewMouseWheel="OnMinutesMouseWheel">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtMinPrev"
                       Text="29"
                       FontSize="13"
                       FontFamily="Consolas, Segoe UI"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       MouseDown="OnMinPrevClicked"
                       Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock x:Name="TxtMinCurr"
                         Text="30"
                         FontSize="24"
                         FontWeight="Bold"
                         FontFamily="Consolas, Segoe UI"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text=" 分"
                         FontSize="12"
                         FontWeight="Normal"
                         Foreground="{StaticResource BlueAccentBrush}"
                         VerticalAlignment="Bottom"
                         Margin="2,0,0,3" />
            </StackPanel>
            <TextBlock x:Name="TxtMinNext"
                       Text="31"
                       FontSize="13"
                       FontFamily="Consolas, Segoe UI"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       MouseDown="OnMinNextClicked"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- 分隔符 2 (冒号) -->
        <TextBlock Grid.Column="3"
                   Text=":"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextMutedBrush}"
                   VerticalAlignment="Center"
                   Margin="4,0,4,2" />

        <!-- 第三列：秒钟 -->
        <Border Grid.Column="4" Background="Transparent" PreviewMouseWheel="OnSecondsMouseWheel">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtSecPrev"
                       Text="59"
                       FontSize="13"
                       FontFamily="Consolas, Segoe UI"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       MouseDown="OnSecPrevClicked"
                       Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock x:Name="TxtSecCurr"
                         Text="00"
                         FontSize="24"
                         FontWeight="Bold"
                         FontFamily="Consolas, Segoe UI"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text=" 秒"
                         FontSize="12"
                         FontWeight="Normal"
                         Foreground="{StaticResource BlueAccentBrush}"
                         VerticalAlignment="Bottom"
                         Margin="2,0,0,3" />
            </StackPanel>
            <TextBlock x:Name="TxtSecNext"
                       Text="01"
                       FontSize="13"
                       FontFamily="Consolas, Segoe UI"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       MouseDown="OnSecNextClicked"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- 顶部 3D 隐没渐变遮罩 -->
      <Border Height="34"
              VerticalAlignment="Top"
              IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#E60D0F14" Offset="0.0" />
            <GradientStop Color="#000D0F14" Offset="1.0" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- 底部 3D 隐没渐变遮罩 -->
      <Border Height="34"
              VerticalAlignment="Bottom"
              IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#000D0F14" Offset="0.0" />
            <GradientStop Color="#E60D0F14" Offset="1.0" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>
  </Border>
</UserControl>
